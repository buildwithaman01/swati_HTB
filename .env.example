# =============================================================================
# SWATI HOME TUITION BUREAU — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Instructions: Copy this file to .env.local and populate the values below.
# DO NOT commit real secrets or production credentials to version control.
# =============================================================================

# 1. Supabase Infrastructure
# Project Settings -> API: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 2. Notification & Form Handlers
# Web3Forms API Key for HTML transactional email alerts
WEB3FORMS_KEY=your-web3forms-access-key

# Google Apps Script Webhook URL for Master KYC Spreadsheet sync
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

# 3. Optional CRM Integration
# Vtiger CRM endpoint for lead synchronization
VTIGER_CRM_API_URL=https://your-crm-domain.com/modules/Webforms/post.php
VTIGER_APP_KEY=your-vtiger-app-key
